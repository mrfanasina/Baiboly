<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================= -->
    <!-- 🌞 LIGHT THEME (MATERIAL 3) -->
    <!-- ========================= -->
    <style name="Theme.Baiboly" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Couleurs primaires (Teal/Sarcelle) -->
        <item name="colorPrimary">#C40E5A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#33B8C4</item>
        <item name="colorOnPrimaryContainer">#002020</item>

        <!-- Couleurs secondaires (Rose) -->
        <item name="colorSecondary">#256EC7</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#E9E9E9</item>
        <item name="colorOnSurface">#1F2937</item>
        <item name="colorSurfaceVariant">#F3F4F6</item>
        <item name="colorOnSurfaceVariant">#4B5563</item>
        <item name="colorOutline">#B4B4B4</item> <!-- Couleur de la bordure OutlinedBox -->

        <item name="colorError">#B00020</item>

        <!-- Barre d'état (StatusBar) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>

        <!-- Style par défaut pour les champs de texte -->
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- ========================= -->
    <!-- 🔘 STYLE DES BOUTONS (M3) -->
    <!-- ========================= -->
    <style name="NumPadButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#1F2937</item>
        <!-- En M3, on utilise containerColor plutôt que backgroundTint pour les boutons -->
        <item name="backgroundTint">#F3F4F6</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="materialButtonStyle">
            @style/Widget.Material3.Button.TonalButton
        </item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MediumComponent</item>


        <!-- Selected toggle button background -->
        <item name="colorSecondaryContainer">@color/teal_700</item>

        <!-- Text on selected button -->
        <item name="colorOnSecondaryContainer">@android:color/white</item>

    </style>

    <!-- Formes arrondies -->
    <style name="ShapeAppearance.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Style ultra-léger sans bordure -->
    <style name="Widget.App.Button.LightToggle" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">1dp</item> <!-- Supprime la bordure -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LargeComponent</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button.LightToggle</item>
    </style>

    <style name="ThemeOverlay.App.Button.LightToggle" parent="">
        <!-- Couleur de fond quand SELECTIONNÉ : un rose très très pâle ou gris clair -->
        <item name="colorPrimaryContainer">#FCE4EC</item>
        <!-- Couleur du texte quand SELECTIONNÉ : votre couleur primaire -->
        <item name="colorOnPrimaryContainer">#C40E5A</item>
    </style>

    <style name="ShapeAppearance.LargeComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.Baiboly.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.Baiboly.AppWidgetContainer" parent="Theme.Baiboly.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>

    <!-- Splash theme: no system icon, direct custom splash -->
    <style name="Theme.Baiboly.Splash" parent="Theme.Baiboly">
        <item name="android:windowBackground">@color/bgColor</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>