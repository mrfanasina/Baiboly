<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlays de couleurs choisies par l'utilisateur (Paramètres > Loko).

    Chaque nuance a deux overlays indépendants :
      - ColorPrimaryN   : remplace la famille colorPrimary (boutons, icônes,
                          sliders, headers, barre de navigation...)
      - ColorSecondaryN : remplace la famille colorSecondary

    Les deux sont appliqués au thème de chaque Activity avant l'inflation
    (voir ColorManager.applyTheme) : les couleurs servent donc PARTOUT.
    La couleur d'erreur (colorError) n'est jamais touchée.
-->
<resources>

    <style name="ColorPrimary0" parent="">
        <item name="colorPrimary">#C40E5A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#29C40E5A</item>
        <item name="colorOnPrimaryContainer">#C40E5A</item>
    </style>

