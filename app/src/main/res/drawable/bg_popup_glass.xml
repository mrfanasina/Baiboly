<?xml version="1.0" encoding="utf-8"?>
<!-- Menu contextuel : surface translucide arrondie (le fond de l'écran
     reste deviné derrière). Le padding laisse respirer les items. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6FFFFFF" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <padding
        android:left="6dp"
        android:right="6dp"
        android:top="6dp"
        android:bottom="6dp" />
</shape>
