<?xml version="1.0" encoding="utf-8"?>
<!-- Texte + icône du toggle "Ankavia / Mitovy" : blanc sur le bouton
     coché (fond = colorPrimary), gris sinon. Remplace le rose par défaut
     (colorPrimary) du bouton outlined non coché. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorOnPrimary"/>
    <item android:color="#6B7280"/>
</selector>
