<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nextPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/neighborLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manaraka"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/muted" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/nextIconBg"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circle_dot" />

            <ImageView
                android:id="@+id/nextIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/nextTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/nextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/nextArrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="20dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Manaraka" />
    </LinearLayout>

    <!-- Suggestions d'historique (bandeau bas, style suggestions des
         autres apps) : dernières lectures consultées, hors type de la
         page voisine. Cliquables -> ouverture directe de la lecture. -->
    <LinearLayout
        android:id="@+id/historyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/historyBarIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_history"
            app:tint="?attr/colorOnSurfaceVariant" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:scrollbars="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="24dp">

            <LinearLayout
                android:id="@+id/historyChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
