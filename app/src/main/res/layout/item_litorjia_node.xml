<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Gauche : guides d'indentation + chevron pour les sections -->
    <FrameLayout
        android:id="@+id/indentArea"
        android:layout_width="28dp"
        android:layout_height="48dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="1.2" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/lit_ic_hymn"
                app:tint="?attr/colorPrimary"
                tools:tint="#C40E5A" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Hira" />

            <TextView
                android:id="@+id/badgeTodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:background="@drawable/bg_badge_chant"
                android:textSize="11sp"
                android:textColor="#EF6C00"
                android:visibility="gone"
                tools:text="hamenoana" />

            <!-- Poignée de glisser-déposer : cible tactile 40dp en édition -->
            <ImageView
                android:id="@+id/imgDrag"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="@string/lit_drag_handle"
                app:tint="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="FFPM 12 · 1,2,3" />
    </LinearLayout>

    <!-- Suppression : visible en édition, à droite de chaque ligne -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnDeleteRow"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lit_act_delete"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
