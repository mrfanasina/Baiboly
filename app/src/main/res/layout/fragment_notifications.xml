<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mampiditra ny hira"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="6dp"/>

        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="#4E71C7"
            android:layout_marginBottom="10dp"/>

        <!-- BARRE DE SAISIE PREMIUM -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- GAUCHE : LARGEUR FIXE (Fixe l'emplacement du 1er séparateur) -->
                <LinearLayout
                    android:id="@+id/btnSelectCategory"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvCategorySelected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sokajy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        android:alpha="0.7"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <!-- SÉPARATEUR 1 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/title_gray"
                        android:alpha="0.15" />
                </LinearLayout>

                <!-- CENTRE : LE NUMÉRO (Parfaitement centré car les côtés font 100dp) -->
                <TextView
                    android:id="@+id/tvSongNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="---"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:letterSpacing="0.05" />

                <!-- DROITE : LARGEUR FIXE (Fixe l'emplacement du 2ème séparateur) -->
                <!-- DROITE : LARGEUR FIXE 106dp -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- SÉPARATEUR 2 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:background="@color/title_gray"
                        android:alpha="0.15" />

                    <!-- ESPACE FLEXIBLE -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- BOUTON RETOUR : Marge augmentée pour le décoller du bord -->
                    <ImageButton
                        android:id="@+id/btnBackspace"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="28dp"
                        android:src="@drawable/ic_backspace"
                        android:scaleType="centerInside"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#EF4444" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 hira misy"
            android:textSize="12sp"
            android:alpha="0.6"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- CLAVIER NUMÉRIQUE -->
        <GridLayout
            android:id="@+id/numPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <Button style="@style/NumPadButton" android:text="1" android:tag="1"/>
            <Button style="@style/NumPadButton" android:text="2" android:tag="2"/>
            <Button style="@style/NumPadButton" android:text="3" android:tag="3"/>
            <Button style="@style/NumPadButton" android:text="4" android:tag="4"/>
            <Button style="@style/NumPadButton" android:text="5" android:tag="5"/>
            <Button style="@style/NumPadButton" android:text="6" android:tag="6"/>
            <Button style="@style/NumPadButton" android:text="7" android:tag="7"/>
            <Button style="@style/NumPadButton" android:text="8" android:tag="8"/>
            <Button style="@style/NumPadButton" android:text="9" android:tag="9"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackspacePad"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                app:icon="@drawable/clear"
                app:iconSize="26dp"
                app:iconGravity="textStart"
                app:iconTint="#EF4444"
                app:backgroundTint="#15EF4444"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp" />

            <Button style="@style/NumPadButton" android:text="0" android:tag="0"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValidate"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                app:icon="@drawable/ic_check1"
                app:iconSize="26dp"
                app:iconGravity="textStart"
                app:backgroundTint="#10B981"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp" />
        </GridLayout>

        <!-- LISTE SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hira rehetra"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"/>

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:background="#F59E0B"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>