<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_top"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Poignée de glissement -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:alpha="0.3"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ANDININY"
        android:textSize="12sp"
        android:textStyle="bold"
        android:alpha="0.6"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/textReferenceSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary" />

    <!-- Aperçu du texte du verset -->
    <TextView
        android:id="@+id/textVerseContentSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:maxLines="6"
        android:ellipsize="end"
        android:alpha="0.9"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="1. Tamin'ny voalohany ny Teny, ary ny Teny tao amin'Andriamanitra, ary Andriamanitra ny Teny." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Kopia"
            app:icon="@drawable/copy_solid_full"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Zarao"
            app:icon="@android:drawable/ic_menu_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hijery feno"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>