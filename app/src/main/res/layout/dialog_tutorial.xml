<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg_dialog_tutorial"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="48dp"
    android:elevation="8dp">

    <!-- Illustration -->
    <ImageView
        android:id="@+id/tutorialImage"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/book_open"
        app:tint="@color/teal_700" />

    <!-- Titre -->
    <TextView
        android:id="@+id/tutorialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tongasoa eto!"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:fontFamily="sans-serif-medium" />

    <!-- Description -->
    <TextView
        android:id="@+id/tutorialDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:textSize="16sp"
        android:lineSpacingExtra="5dp"
        android:textColor="#4B5563" />

    <!-- Indicateurs de page (points) -->
    <LinearLayout
        android:id="@+id/dotContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:orientation="horizontal" />

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avelao"
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manaraka"
            android:textAllCaps="false"
            app:cornerRadius="28dp"
            android:paddingHorizontal="28dp"
            android:layout_marginStart="12dp"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
