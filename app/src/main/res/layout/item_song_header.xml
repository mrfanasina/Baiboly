<?xml version="1.0" encoding="utf-8"?>
<!-- En-tête cliquable ("Fihirana FFPM | 49"), premier item du RecyclerView.
     La pilule est teintée en code avec la couleur principale (alpha réduit). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/songHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Safidy hira">

        <TextView
            android:id="@+id/headerCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fihirana"
            android:paddingStart="16dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="?attr/colorPrimary" />

        <View
            android:id="@+id/headerDivider"
            android:layout_width="2.5dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="12dp"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:id="@+id/headerNumberCell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingEnd="16dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/headerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="49"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
