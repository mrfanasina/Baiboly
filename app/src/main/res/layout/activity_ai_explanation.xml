<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:popupTheme="@style/ThemeOverlay.Material3" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Zone de chat : RecyclerView + éléments flottants superposés
             (disclaimer en bas, pastille "nouveau message"). Le FrameLayout
             permet à ces éléments de ne jamais pousser le contenu, donc le
             fondu seul (alpha) suffit, sans gérer de hauteur. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="36dp" />

            <!-- Pastille "nouveau message", au-dessus du disclaimer -->
            <TextView
                android:id="@+id/chipNewMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="34dp"
                android:alpha="0"
                android:background="@drawable/bg_send_button"
                android:backgroundTint="?attr/colorPrimary"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="↓ Valiny vaovao"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Disclaimer flottant, ancré en bas, superposé au chat.
                 Ne pousse jamais le contenu : le fondu seul gère son
                 apparition/disparition. -->
            <TextView
                android:id="@+id/tvDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="1"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text=" Mety hisy fahadisoana ny valin'ny AI. Hamarino amin'ny loharano azo itokisana"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

        </FrameLayout>

        <!-- Barre de saisie : carte flottante arrondie, détachée des bords. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shape_input_bar_floating"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_floating_pill"
                android:hint="Manontany ..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Alefa"
                android:padding="11dp"
                android:src="@drawable/ic_send"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>