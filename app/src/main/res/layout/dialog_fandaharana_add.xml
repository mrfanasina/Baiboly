<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_tutorial"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="48dp"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ampidiro ao amin'ny fandaharana"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <!-- Input: Reference (verse/song/fanekena) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Loharano (ohatra: Jao 1:1-5, ffpm_171, fanekena)"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Type selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Karazana"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Verse button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeVerse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vakiteny"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Song button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeSong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hira"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Fanekena button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeFanekena"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fanekena"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Akatona"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ampidiro"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
